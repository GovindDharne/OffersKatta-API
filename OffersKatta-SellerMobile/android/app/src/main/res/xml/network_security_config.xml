<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext HTTP only to the dev API hosts. 10.0.2.2 is the Android
         emulator's loopback alias for the host; 192.168.31.178 is the current
         dev machine's LAN IP for physical-device builds. Add new dev IPs here
         instead of opening up cleartext to everything. The alternative is
         passing API_BASE_URL via flutter run dart-define. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.31.178</domain>
        <domain includeSubdomains="false">192.168.0.155</domain>
    </domain-config>
</network-security-config>
