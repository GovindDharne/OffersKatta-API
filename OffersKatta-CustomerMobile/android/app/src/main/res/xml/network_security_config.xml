<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- DEV: allow cleartext HTTP to any host so the app can talk to the dev API
         over the LAN regardless of the machine's current IP. Tighten before release. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
