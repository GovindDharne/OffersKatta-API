{
  "extends": "@offerhub/config/tsconfig/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@offerhub/shared": ["../../packages/shared/src"],
      "@offerhub/shared/*": ["../../packages/shared/src/*"],
      "@offerhub/ui": ["../../packages/ui/src"]
    }
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
