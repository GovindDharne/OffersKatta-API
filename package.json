{
  "name": "offerskatta-api-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "OffersKatta NestJS API — standalone repo extracted from the OffersKatta monorepo.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @offerhub/api dev",
    "build": "pnpm --filter @offerhub/api build",
    "start": "pnpm --filter @offerhub/api start",
    "start:prod": "pnpm --filter @offerhub/api start:prod",
    "test": "pnpm --filter @offerhub/api test",
    "test:e2e": "pnpm --filter @offerhub/api test:e2e",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:generate": "pnpm --filter @offerhub/api db:generate",
    "db:migrate": "pnpm --filter @offerhub/api db:migrate",
    "db:migrate:deploy": "pnpm --filter @offerhub/api db:migrate:deploy",
    "db:reset": "pnpm --filter @offerhub/api db:reset",
    "db:seed": "pnpm --filter @offerhub/api db:seed",
    "db:studio": "pnpm --filter @offerhub/api db:studio",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2"
  }
}
