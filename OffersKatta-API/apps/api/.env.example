# ============================================================
# OffersKatta API — apps/api/.env.example
# ============================================================

NODE_ENV=development
PORT=4000

# Database
DATABASE_URL=postgresql://offerhub:offerhub_dev_password@postgres:5432/offerhub?schema=public

# Redis
REDIS_URL=redis://redis:6379
REDIS_TTL=300

# JWT
JWT_SECRET=replace-with-strong-random-secret
JWT_REFRESH_SECRET=replace-with-different-strong-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google Places (autocomplete on branch form). Leave blank to disable —
# the UI will fall back to manual entry + map picker.
# Get the key from console.cloud.google.com → APIs & Services → enable
# "Places API" (legacy) → restrict to your server IP for safety.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_REGION=in

# SMTP (uses MailHog in dev)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@offerhub.local

# Throttling
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost

# Seed
SEED_ADMIN_EMAIL=admin@offerhub.local
SEED_ADMIN_PASSWORD=Admin@12345
